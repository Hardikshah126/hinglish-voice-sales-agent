# Copy to .env and fill in. .env is git-ignored; never commit real keys.
#
# Fully free setup: only GROQ_API_KEY is needed (https://console.groq.com/keys).
#   LLM (agent, customer simulator, judge)  -> Groq
#   Speech-to-text                          -> Groq Whisper
#   Text-to-speech                          -> the browser's built-in speech synthesis
# Anything without credentials falls back to a mock and is labelled MOCK everywhere.

# --- Groq (free tier) ---------------------------------------------------------
GROQ_API_KEY=

# --- OpenAI (optional, paid): only used for STT/TTS if you choose ---------------
OPENAI_API_KEY=

# --- Database ----------------------------------------------------------------
# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+psycopg://salesagent:salesagent@localhost:5433/salesagent

# --- Models (verify with: python -m app.cli verify-models) -------------------------
LLM_MODEL=qwen/qwen3.8-27b
SIMULATOR_MODEL=openai/gpt-oss-20b
# A different model family from the agent reduces judge self-preference bias.
JUDGE_MODEL=openai/gpt-oss-120b
# Leave STT_MODEL empty to use whisper-large-v3-turbo (Groq) or gpt-4o-mini-transcribe (OpenAI).
STT_MODEL=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash

# --- Provider selection ---------------------------------------------------------
# auto: use whatever has credentials, mock otherwise. mock: force mocks. live: require GROQ_API_KEY.
PROVIDER_MODE=auto
# auto | groq | openai | mock
STT_PROVIDER=auto
# auto (OpenAI if key, else free browser voice) | openai | browser | mock
TTS_PROVIDER=auto

# --- App ----------------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
